PORT=4000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# CORS — agregar la URL del frontend
ALLOWED_ORIGINS=http://localhost:3000,https://airnation.online

# Cloudflare Images
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# Cloudflare Stream (videos del feed) — requiere Workers Paid + Stream habilitado
# en el dashboard de Cloudflare. El token necesita permiso Stream:Edit.
# Sirve cualquiera de los dos nombres:
# CF_ACCOUNT_ID=        (alias de CLOUDFLARE_ACCOUNT_ID)
# CF_STREAM_API_TOKEN=  (token con scope de Stream; tiene prioridad)
# O reutiliza CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN si ese token ya
# tiene permiso de Stream.

# IndexNow (Bing y otros buscadores)
INDEXNOW_KEY=ab4d9f682857617747215880491449c2
INDEXNOW_HOST=www.airnation.online
# true solo en producción
INDEXNOW_AUTO=false

# Resend (notificación al founder: solicitud para unirse al equipo)
RESEND_API_KEY=re_xxxxxxxx
# Opcional; por defecto onboarding@resend.dev
RESEND_FROM_EMAIL=AirNation <notificaciones@tudominio.com>

# JOULIE. OPENROUTER_API_KEY (la del validador de credenciales) ya basta para el texto.
# Todo lo de abajo va SOLO en Railway. Nada de esto va en Vercel.
# ELEVENLABS_API_KEY necesita, además de text_to_speech y voices_read:
# convai_read y convai_write (ElevenAgents).
ELEVENLABS_API_KEY=
# Secreto compartido con el agente. El script lo guarda en ElevenLabs.
# El navegador nunca lo ve.
JOULIE_ELEVEN_LLM_SECRET=
# Lo imprime backend/scripts/joulie-eleven-agent.mjs
# JOULIE_ELEVEN_AGENT_ID=
# Opcional. Si no se define, el código usa la voz Norah (kcQkGnn0HAT2JRDQ4Ljp).
# ELEVENLABS_VOICE_ID=
# Opcionales; el código ya trae estos defaults:
# JOULIE_MODEL=google/gemini-2.5-flash
# JOULIE_MAX_OUTPUT_TOKENS=140
# JOULIE_MAX_INPUT_CHARS=500
# JOULIE_TIMEOUT_MS=18000
# JOULIE_RATE_PER_MIN=8
# JOULIE_DAILY_CAP=40
# La voz cuenta un turno real, no cada reintento de ElevenLabs. JOULIE_VOICE_RATE_PER_MIN=30
# JOULIE_VOICE_DAILY_CAP=120
# JOULIE_DAILY_MINUTES=15
# Búsqueda web solo en recomendaciones de equipo. JOULIE_WEB_SESSION=3
# JOULIE_WEB_DAILY=8
# JOULIE_LLM_PUBLIC_URL=https://air-nation-production.up.railway.app/api/v1/joulie/llm

# Migración legacy R2 → Cloudflare Stream (scripts/migrate-player-posts-to-stream.js)
# Mismas credenciales Stream que /upload/video. Opcional:
# MIGRATE_STREAM_MAX_DURATION_SEC=300
